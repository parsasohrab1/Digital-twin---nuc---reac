# ============================================================
# Nuclear Digital Twin (NDT) – Environment Configuration
# Copy to .env and adjust values for your deployment
# ============================================================

# --- General ---
NDT_ENV=development
NDT_LOG_LEVEL=INFO
NDT_TIMEZONE=Asia/Tehran

# --- API Gateway ---
API_GATEWAY_HOST=0.0.0.0
API_GATEWAY_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- Frontend ---
VITE_API_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000/ws/reactor

# --- PostgreSQL ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=ndt
POSTGRES_USER=ndt_user
POSTGRES_PASSWORD=change_me_secure_password

# --- InfluxDB 2.x (Time Series) ---
INFLUXDB_URL=http://influxdb:8086
INFLUXDB_TOKEN=ndt-dev-token-change-in-production
INFLUXDB_ORG=ndt
INFLUXDB_BUCKET=sensor_data
INFLUXDB_RETENTION=30d

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- RabbitMQ (Inter-service messaging) ---
RABBITMQ_URL=amqp://ndt:change_me_rabbit@rabbitmq:5672/
RABBITMQ_USER=ndt
RABBITMQ_PASSWORD=change_me_rabbit

# --- OPC UA (Sensor Gateway) ---
OPCUA_ENDPOINT=opc.tcp://opcua-simulator:4840/freeopcua/server/
OPCUA_SECURITY_POLICY=None
OPCUA_SAMPLE_RATE_HZ=10
OPCUA_SENSOR_TIMEOUT_SEC=3

# --- Modbus TCP (Alternative) ---
MODBUS_ENABLED=false
MODBUS_HOST=192.168.1.100
MODBUS_PORT=502

# --- PINN Core (GPU) ---
PINN_MODEL_PATH=/app/models/pinn_reactor_v1.pt
PINN_INFERENCE_DEVICE=cpu
PINN_LAMBDA_NS=0.1
PINN_LAMBDA_ENERGY=0.1
PINN_LAMBDA_NEUTRONICS=0.01

# --- EKF Adapter ---
EKF_UPDATE_INTERVAL_SEC=1
EKF_BUFFER_SIZE=1000
EKF_INNOVATION_THRESHOLD=3.0

# --- Predictor ---
PREDICTOR_TREND_INTERVAL_SEC=10
PREDICTOR_SCENARIO_COUNT=500
PREDICTOR_HORIZON_SEC=300

# --- DSS ---
DSS_NSGA2_POPULATION=100
DSS_MAX_RUNTIME_MS=500
DSS_TOP_RECOMMENDATIONS=3

# --- Alerts ---
ALERT_DNBR_CRITICAL_TTE_SEC=300
ALERT_CLAD_TEMP_TTE_SEC=600
ALERT_SNOOZE_MINUTES=5

# --- Security ---
JWT_SECRET=change_me_jwt_secret_min_32_chars
JWT_EXPIRE_MINUTES=480
TLS_ENABLED=false
